# Salin ke .env.production di VPS. File sebenarnya tidak masuk Git/image.
# Frontend dan API harus berada di domain induk yang sama.
ROOT_DOMAIN=tokokamu.com
FRONTEND_DOMAIN=tokokamu.com
API_DOMAIN=api.tokokamu.com
ACME_EMAIL=admin@tokokamu.com

# Saat memindahkan data, pakai APP_KEY dari backend/.env lokal.
# Jika instalasi benar-benar baru, generate key seperti di deploy/README.md.
APP_KEY=
DB_DATABASE=web-katalog-jersy
DB_USERNAME=bp_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# IP proxy harus berada dalam subnet ini. Ganti keduanya bila bentrok.
DOCKER_SUBNET=172.30.50.0/24
PROXY_IP=172.30.50.2
